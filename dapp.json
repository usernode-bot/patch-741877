{
  "name": "Patch",
  "description": "The Homeroom class pet. Hatch it, feed it, play with it, then help decide what it does next.",
  "icon": { "emoji": "🐣" },
  "secrets": [],
  "tests": [
    { "name": "Egg renders", "path": "/", "expectSelector": "#egg" },
    { "name": "Onboarding shell has no console errors", "path": "/", "expectText": "An egg" },
    { "name": "Change pet dialog renders in shell", "path": "/", "expectSelector": "#change-pet" },
    {
      "name": "Happiness meter sits beside the other meters",
      "path": "/?demo=1",
      "expectSelector": "#meter-happy",
      "visual": true,
      "id": "pet.happiness-meter",
      "impact": ["public/index.html", "public/patch.js", "public/patch.css", "server.js"]
    },
    {
      "name": "Weight log renders on the pet page",
      "path": "/?demo=1",
      "expectSelector": "#weight-card",
      "expectText": "Weight"
    },
    {
      "name": "Weight chart draws the demo history",
      "path": "/?demo=1",
      "expectSelector": "#weight-chart:not([hidden])",
      "visual": true,
      "id": "pet.weight-log",
      "impact": ["public/index.html", "public/patch.js", "public/patch.css", "server.js"]
    }
  ]
}
